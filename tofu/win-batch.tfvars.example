# win-batch — a dedicated, teardownable Windows desktop node (Hetzner Cloud,
# TCG). Copy to win-batch.tfvars and run it in its OWN context/workspace so its
# lifecycle is independent of the live cluster:
#
#   mise run up   -- --context win-batch        # provision the cpx42 win node
#   mise run recipe windows -- --context win-batch
#   # ...work over RDP (windows.<domain>:3389)...
#   mise run down -- --context win-batch         # snapshot first, then destroy
#
# Same domain/zone/ssh as the cluster — only the node class differs.

cloudflare_zone_id = "d24de2d0e3a152395432f6767c4c472e"  # amplifycms.com
domain             = "amplifycms.com"
dns_apex           = false

cluster_name = "win-batch"        # names the server + firewall + uncloud context
node_count   = 1
server_type  = "cpx42"            # 8 vCPU / 16 GB — Windows needs the headroom (~€28/mo while up)
image        = "ubuntu-24.04"
location     = "fsn1"

windows = true                    # opens RDP :3389, points windows.<domain> here, no wildcard

ssh_key_name         = "gedw99_hetzner"
ssh_private_key_file = "~/.ssh/gedw99_hetzner"

# RDP + SSH are restricted to this allowlist — TIGHTEN to your IP, e.g.
# ssh_allowed_ips = ["203.0.113.4/32"]
ssh_allowed_ips = ["0.0.0.0/0", "::/0"]
