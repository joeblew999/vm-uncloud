# Secrets never live on disk — they come from fnox/keychain.
.env
*.tfvars
*.auto.tfvars

# Generated remote-state backend config (contains your R2 account id).
tofu/backend.tf
tofu/backend.hcl

# OpenTofu / Terraform state and local provider cache.
tofu/.terraform/
tofu/.terraform.lock.hcl
tofu/*.tfstate
tofu/*.tfstate.*
tofu/crash.log
tofu/override.tf
tofu/override.tf.json

# Live Caddy snippet (may contain internal IPs) — keep only the .example template.
caddy/external.caddyfile

# Upstream recipes are referenced, not vendored — cloned on demand by `mise run recipe:deploy`.
.src/

# Local scratch.
.DS_Store

# Generated per-app secret pointers (values live in the keychain).
fnox.secrets.toml

# xs event store (binary; regenerated at runtime by gui:up / xs:serve).
state/xs.store/
